---

<section id="kontakt" class="relative mx-auto max-w-6xl px-6 py-16 md:py-20 xl:py-8 xl:min-h-[calc(100svh-80px)] xl:flex xl:flex-col xl:justify-center">

  <!-- Subtelny glow w tle -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 70% 50% at 50% 100%, rgba(249,115,22,0.07) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="max-w-4xl mx-auto w-full">
  <!-- Header -->
  <div class="text-center mb-10">
    <p data-animate="fade-up" class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Napisz do nas</p>
    <h2 data-animate="fade-up" data-delay="100" class="font-display text-3xl md:text-5xl font-bold text-white">Kontakt</h2>
    <p data-animate="fade-up" data-delay="200" class="mt-4 text-white/55 max-w-lg mx-auto leading-relaxed">
      Masz pytanie lub pomysł na projekt? Wybierz najwygodniejszy kanał — odpisujemy szybko.
    </p>
  </div>

  <!-- Karty kontaktowe -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
    {contacts.map(({ platform, value, href, external, icon }, i) => (
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        data-animate="fade-up"
        data-delay={String(i * 80)}
        class="group flex items-center gap-4 p-5 rounded-2xl bg-surface-card border border-surface-border hover:border-white/20 hover:-translate-y-0.5 transition-all duration-200"
      >
        <!-- Ikona -->
        <div class="w-11 h-11 rounded-xl bg-surface-elevated border border-surface-border flex items-center justify-center shrink-0 group-hover:border-accent/40 group-hover:bg-accent/5 transition-colors duration-200">
          <svg class="w-5 h-5 text-white/50 group-hover:text-accent transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" set:html={icon} />
        </div>

        <!-- Tekst -->
        <div class="flex-1 min-w-0">
          <p class="text-xs font-medium uppercase tracking-widest text-white/35 mb-0.5">{platform}</p>
          <p class="text-base font-semibold text-white/85 truncate group-hover:text-white transition-colors duration-200">{value}</p>
        </div>

        <!-- Strzałka -->
        <svg
          class="w-4 h-4 text-white/15 shrink-0 group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-200"
          fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    ))}
  </div>

  <!-- Stopka -->
  <p data-animate="fade-up" data-delay="400" class="mt-8 text-center text-sm text-white/30">
    Zazwyczaj odpisujemy w ciągu 24 godzin w dni robocze.
  </p>
  </div>

</section>
