---
const values = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />`,
    title: 'Estetyczny design',
    desc: 'Dbamy o każdy piksel — strony, które wyglądają profesjonalnie i budują zaufanie od pierwszej sekundy.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
    title: 'Szybkość i SEO',
    desc: 'Strony zoptymalizowane pod wyszukiwarki i szybkie ładowanie — żeby klienci mogli Cię łatwo znaleźć w Google.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />`,
    title: 'Indywidualne podejście',
    desc: 'Każdy projekt dopasowujemy do Twojej marki i celów. Słuchamy, doradzamy i dostarczamy rozwiązanie skrojone na miarę.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />`,
    title: 'Nowoczesne technologie',
    desc: 'Korzystamy z nowoczesnych narzędzi i integrujemy zewnętrzne serwisy — formularze, systemy rezerwacji, analitykę i więcej.',
  },
];
---

<section id="novaflow" class="mx-auto max-w-6xl px-6 py-16 md:py-28">
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-10 xl:gap-16 items-start xl:items-center">

    <!-- Lewa kolumna — tekst -->
    <div class="text-center xl:text-left">
      <p data-animate="fade-up" class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Kim jesteśmy</p>
      <h2 data-animate="fade-up" data-delay="100" class="font-display text-3xl md:text-5xl font-bold text-white leading-tight">
        Nova<span class="text-gradient">Flow</span>Design
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-6 text-white/65 leading-relaxed max-w-lg mx-auto xl:mx-0">
        W NovaFlowDesign tworzymy nowoczesne strony www dla firm, freelancerów i marek osobistych — każdy projekt realizujemy indywidualnie.
      </p>

      <p data-animate="fade-up" data-delay="280" class="mt-4 text-white/65 leading-relaxed max-w-lg mx-auto xl:mx-0">
        Wierzymy, że dobra strona to nie tylko estetyczny wygląd — to narzędzie, które pracuje na Twój biznes. Dlatego każdy projekt budujemy z myślą o użytkowniku, szybkości działania i widoczności w wyszukiwarkach.
      </p>

      <div data-animate="fade-up" data-delay="360" class="mt-8 flex flex-wrap justify-center xl:justify-start gap-3">
        {['Szybka realizacja', 'Doświadczenie', 'Zadowoleni klienci'].map((label) => (
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-card border border-surface-border text-sm font-medium text-white/70">
            <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
            {label}
          </span>
        ))}
      </div>
    </div>

    <!-- Prawa kolumna — wartości 2×2 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto xl:mx-0 w-full">
      {values.map(({ icon, title, desc }, i) => (
        <div data-animate="fade-up" data-delay={String(i * 100)} class="p-5 md:p-6 rounded-2xl bg-surface-card border border-surface-border hover:border-white/20 transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-surface-elevated border border-surface-border flex items-center justify-center mb-4 mx-auto xl:mx-0 group-hover:border-accent/40 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              set:html={icon}
            />
          </div>
          <h3 class="font-display text-sm font-bold text-white mb-2 text-center xl:text-left">{title}</h3>
          <p class="text-sm text-white/50 leading-relaxed text-center xl:text-left">{desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
