---
const values = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />`,
    title: 'Estetyczny design',
    desc: 'Dbamy o każdy piksel — strony, które wyglądają profesjonalnie i budują zaufanie od pierwszej sekundy.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
    title: 'Szybkość i SEO',
    desc: 'Statyczne strony ładują się błyskawicznie. Każdy projekt jest zoptymalizowany pod Core Web Vitals i wyszukiwarki.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />`,
    title: 'Indywidualne podejście',
    desc: 'Żadnych gotowych szablonów. Każdy projekt zaczynamy od rozmowy — słuchamy i dopasowujemy rozwiązanie do Twoich celów.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />`,
    title: 'Nowoczesne technologie',
    desc: 'Astro, Tailwind CSS, TypeScript — nowoczesny stack, który gwarantuje wydajność, bezpieczeństwo i łatwe utrzymanie.',
  },
];
---

<section id="novaflow" class="mx-auto max-w-6xl px-6 py-24 md:py-36">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

    <!-- Lewa kolumna — tekst -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Kim jesteśmy</p>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-white leading-tight">
        Nova<span class="text-gradient">Flow</span>Design
      </h2>

      <p class="mt-6 text-white/65 leading-relaxed">
        NovaFlowDesign to niezależna pracownia tworzenia stron internetowych, skupiona na jakości ponad ilość.
        Tworzymy nowoczesne strony www dla firm, freelancerów i marek osobistych — każdy projekt indywidualnie,
        bez gotowych szablonów i bez kompromisów.
      </p>

      <p class="mt-4 text-white/65 leading-relaxed">
        Wierzymy, że dobra strona to nie tylko estetyczny wygląd — to narzędzie, które pracuje na Twój biznes.
        Dlatego każdy projekt budujemy z myślą o użytkowniku, szybkości działania i widoczności w wyszukiwarkach.
      </p>

      <div class="mt-8 flex items-center gap-10">
        <div>
          <p class="font-display text-3xl font-bold text-gradient">10+</p>
          <p class="text-sm text-white/40 mt-1">zrealizowanych projektów</p>
        </div>
        <div class="w-px h-10 bg-surface-border"></div>
        <div>
          <p class="font-display text-3xl font-bold text-gradient">100%</p>
          <p class="text-sm text-white/40 mt-1">zadowolonych klientów</p>
        </div>
        <div class="w-px h-10 bg-surface-border"></div>
        <div>
          <p class="font-display text-3xl font-bold text-gradient">3+</p>
          <p class="text-sm text-white/40 mt-1">lata doświadczenia</p>
        </div>
      </div>
    </div>

    <!-- Prawa kolumna — wartości 2×2 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {values.map(({ icon, title, desc }) => (
        <div class="p-6 rounded-2xl bg-surface-card border border-surface-border hover:border-white/20 transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-surface-elevated border border-surface-border flex items-center justify-center mb-4 group-hover:border-accent/40 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              set:html={icon}
            />
          </div>
          <h3 class="font-display text-sm font-bold text-white mb-2">{title}</h3>
          <p class="text-sm text-white/50 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
