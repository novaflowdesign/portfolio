---
import Button from '@components/Button.astro';
---

<section class="relative flex flex-col items-center justify-center text-center px-6 py-24 min-h-svh overflow-hidden">

  <!-- Dot grid -->
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="
      background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
      background-size: 36px 36px;
      mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, black 20%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, black 20%, transparent 100%);
    "
  ></div>

  <!-- Aurora orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">

    <!-- Orb 1 — orange, lewo-góra -->
    <div
      class="orb-parallax aurora-1 absolute top-0 left-1/4 w-[520px] h-[520px] rounded-full"
      data-depth="20"
      style="background: radial-gradient(circle, rgba(249,115,22,0.18) 0%, transparent 70%); filter: blur(72px); transform-origin: center;"
    ></div>

    <!-- Orb 2 — amber, prawo-góra -->
    <div
      class="orb-parallax aurora-2 absolute top-0 right-1/4 w-[440px] h-[440px] rounded-full"
      data-depth="14"
      style="background: radial-gradient(circle, rgba(251,191,36,0.12) 0%, transparent 70%); filter: blur(88px); transform-origin: center;"
    ></div>

    <!-- Orb 3 — red-orange, dół -->
    <div
      class="orb-parallax aurora-3 absolute bottom-0 left-1/2 w-[600px] h-[360px] rounded-full"
      data-depth="8"
      style="background: radial-gradient(circle, rgba(234,88,12,0.1) 0%, transparent 70%); filter: blur(100px); transform-origin: center;"
    ></div>

    <!-- Orb 4 — jasny amber, centrum-pulsuje -->
    <div
      class="orb-parallax aurora-4 absolute top-1/3 left-1/2 w-[280px] h-[280px] rounded-full"
      data-depth="30"
      style="background: radial-gradient(circle, rgba(251,191,36,0.14) 0%, transparent 60%); filter: blur(60px); transform-origin: center;"
    ></div>

  </div>

  <!-- Treść -->
  <div class="relative max-w-4xl mx-auto">
    <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] font-display text-gradient">
      Rozpocznij swój projekt już dziś
    </p>

    <h1 class="font-display text-3xl md:text-5xl lg:text-6xl font-bold leading-[1.15] tracking-tight text-white">
      Tworzymy strony,<br />
      które dobrze wyglądają<br />
      <span class="text-gradient">i jeszcze lepiej działają</span>
    </h1>

    <p class="mt-6 text-base md:text-lg text-white/55 max-w-xl mx-auto leading-relaxed">
      Przemyślana struktura, estetyczny design i sprawne działanie.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="#kontakt" variant="primary" size="lg">
        Skontaktuj się
      </Button>
      <Button href="#realizacje" variant="outline" size="lg">
        Zobacz realizacje
      </Button>
    </div>
  </div>
</section>

<script>
  const orbs = document.querySelectorAll<HTMLElement>('.orb-parallax');
  const cx = window.innerWidth / 2;
  const cy = window.innerHeight / 2;

  window.addEventListener('mousemove', (e) => {
    const dx = (e.clientX - cx) / cx; // -1..1
    const dy = (e.clientY - cy) / cy;
    orbs.forEach((orb) => {
      const depth = parseFloat(orb.dataset.depth ?? '10');
      orb.style.setProperty('--px', String(dx * depth));
      orb.style.setProperty('--py', String(dy * depth));
    });
  }, { passive: true });
</script>
