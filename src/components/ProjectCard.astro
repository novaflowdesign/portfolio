---
interface Props {
  title: string;
  description: string;
  slug: string;
  thumbnail?: string;
  tags?: string[];
}

const { title, description, slug, thumbnail, tags = [] } = Astro.props;
---

<article class="group relative flex flex-col bg-surface-card border border-surface-border rounded-2xl overflow-hidden hover:border-white/20 transition-colors">
  <!-- Thumbnail -->
  <a href={`/realizacje/${slug}`} class="block aspect-video overflow-hidden bg-surface-elevated">
    {thumbnail ? (
      <img
        src={thumbnail}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="text-white/10 font-display text-4xl font-bold">{title.charAt(0)}</span>
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5 md:p-7 gap-3">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-xs font-medium rounded-md bg-surface-elevated text-white/50 border border-surface-border">
            {tag}
          </span>
        ))}
      </div>
    )}

    <h2 class="font-display text-xl font-bold text-white leading-snug">
      <a href={`/realizacje/${slug}`} class="hover:text-accent transition-colors">
        {title}
      </a>
    </h2>

    <p class="text-sm text-white/60 leading-relaxed line-clamp-3">{description}</p>

    <a
      href={`/realizacje/${slug}`}
      class="mt-auto pt-4 text-sm font-medium text-accent hover:text-accent-light transition-colors inline-flex items-center gap-1"
    >
      Zobacz projekt
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
