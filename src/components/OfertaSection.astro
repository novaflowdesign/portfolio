---
import Button from '@components/Button.astro';

const services = [
  {
    title: 'Strona one-page',
    description: 'Prosta, elegancka strona na jednym widoku — idealna dla freelancerów, specjalistów i marek osobistych, które chcą zaistnieć w sieci.',
    includes: [
      'Responsywny design',
      'Szybkie ładowanie strony',
      'Estetyczny, nowoczesny wygląd',
      'Optymalizacja SEO',
      'Formularz kontaktowy',
    ],
  },
  {
    title: 'Strona firmowa',
    description: 'Rozbudowana witryna dla firm, które chcą wyróżnić się w sieci i przyciągać nowych klientów. Z panelem do samodzielnego zarządzania treścią.',
    includes: [
      'Do 10 podstron',
      'Panel administracyjny (CMS)',
      'Integracja z Google Analytics',
      'Rozbudowana struktura treści',
      'Blog/aktualności',
    ],
    featured: true,
  },
  {
    title: 'Strona premium',
    description: 'Zaawansowany projekt dopasowany do specyficznych potrzeb biznesu — z dodatkowymi funkcjami, które automatyzują i usprawniają działanie firmy.',
    includes: [
      'Dedykowane rozwiązanie dla Twojego biznesu',
      'Integracja z systemem płatności',
      'Newsletter',
      'Integracja z płatnościami',
      'Formularz wieloetapowy',
    ],
  },
];
---

<section id="oferta" class="mx-auto max-w-6xl px-6 py-16 md:py-20 xl:py-16 xl:min-h-[calc(100svh-80px)] xl:flex xl:flex-col xl:justify-center">
  <header class="mb-10 text-center max-w-2xl mx-auto">
    <p data-animate="fade-up" class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Co oferujemy</p>
    <h2 data-animate="fade-up" data-delay="100" class="font-display text-3xl md:text-5xl font-bold text-white">Oferta</h2>
    <p data-animate="fade-up" data-delay="200" class="mt-4 text-white/55">
      Każda strona jest dopasowana do potrzeb klienta. Poniżej orientacyjne pakiety — ostateczna wycena zależy od zakresu projektu.
    </p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-6 max-w-md mx-auto lg:max-w-none">
    {services.map((service, i) => (
      <div data-animate="fade-up" data-delay={String(i * 120)} class:list={[
        'relative flex flex-col p-6 md:p-8 lg:p-8 rounded-2xl border transition-colors',
        service.featured
          ? 'bg-surface-elevated border-accent/40 ring-1 ring-accent/20'
          : 'bg-surface-card border-surface-border hover:border-white/20',
      ]}>
        {service.featured && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-bold bg-accent text-white rounded-full font-display tracking-wide">
            Najpopularniejszy
          </span>
        )}

        <h3 class="font-display text-xl font-bold text-white mb-3">{service.title}</h3>
        <p class="text-sm text-white/55 leading-relaxed mb-8">{service.description}</p>

        <ul class="flex flex-col gap-3 mb-10">
          {service.includes.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/70">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <div class="mt-auto">
          <Button href="#kontakt" variant={service.featured ? 'primary' : 'outline'} size="md" class="w-full justify-center">
            Zapytaj o wycenę
          </Button>
        </div>
      </div>
    ))}
  </div>

  <p class="mt-10 text-center text-sm text-white/30">
    Masz niestandardowy projekt? <a href="#kontakt" class="text-white/50 hover:text-white transition-colors underline underline-offset-2">Napisz do nas</a> — wycenimy indywidualnie.
  </p>
</section>
