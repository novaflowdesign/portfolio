        <a href="/" class="font-display font-bold text-lg tracking-tight text-gradient" aria-label="NovaFlowDesign">
          NovaFlowDesign
        </a>
        <span class="text-white/20 text-xs hidden sm:inline">&mdash;</span>
        <p class="text-xs text-white/20 hidden sm:block">&copy; {year} Wszelkie prawa zastrzeżone.</p>
      </div>

      <!-- Nav + social icons -->
      <div class="flex items-center gap-6">
        <nav class="flex items-center gap-6" aria-label="Stopka">
          <a href="/#realizacje" class="text-sm text-white/30 hover:text-white transition-colors">Realizacje</a>
          <a href="/#oferta"     class="text-sm text-white/30 hover:text-white transition-colors">Oferta</a>
          <a href="/#faq"        class="text-sm text-white/30 hover:text-white transition-colors">FAQ</a>
          <a href="/#kontakt"    class="text-sm text-white/30 hover:text-white transition-colors">Kontakt</a>
        </nav>

        <!-- Social icons -->
        <div class="flex items-center gap-1">
          <a href="mailto:novaflowdesign@gmail.com" aria-label="E-mail" class="w-8 h-8 rounded-lg flex items-center justify-center text-white/30 hover:text-white hover:bg-surface-card border border-transparent hover:border-surface-border transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </a>
          <a href="https://instagram.com/novaflowdesign" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-8 h-8 rounded-lg flex items-center justify-center text-white/30 hover:text-white hover:bg-surface-card border border-transparent hover:border-surface-border transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href="https://facebook.com/NovaFlowDesign" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-8 h-8 rounded-lg flex items-center justify-center text-white/30 hover:text-white hover:bg-surface-card border border-transparent hover:border-surface-border transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
