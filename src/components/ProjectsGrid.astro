---
import ProjectCard from '@components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<section id="realizacje" class="mx-auto max-w-6xl px-6 py-24 md:py-36">
  <div class="text-center mb-14">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Portfolio</p>
    <h2 class="font-display text-3xl md:text-5xl font-bold text-white">Realizacje</h2>
    <p class="mt-3 text-white/55 max-w-lg mx-auto">
      Projekty oparte na przemyślanej strukturze i spójnym designie.
    </p>
    {projects.length > 0 && (
      <a
        href="/realizacje"
        class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-white/50 hover:text-white transition-colors"
      >
        Wszystkie projekty
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    )}
  </div>

  {projects.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.id}
          thumbnail={project.data.thumbnail}
          tags={project.data.tags}
        />
      ))}
    </div>
  ) : (
    <p class="text-white/30 text-sm text-center">Projekty pojawią się wkrótce.</p>
  )}
</section>
