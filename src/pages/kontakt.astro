---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';

const email = 'kontakt@novaflowdesign.pl';
---

<BaseLayout
  title="Kontakt"
  description="Skontaktuj się ze mną — opowiedz mi o swoim projekcie i otrzymaj bezpłatną wycenę."
>
  <Header />
  <main class="mx-auto max-w-6xl px-6 py-20 md:py-32">
    <div class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-widest text-accent mb-3">Napisz do mnie</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-white">Kontakt</h1>
      <p class="mt-4 text-lg text-white/60 leading-relaxed">
        Masz pomysł na projekt? Chcesz odświeżyć istniejącą stronę? A może dopiero rozważasz obecność w sieci?
        Napisz — chętnie porozmawiam i bezpłatnie wycenię Twój projekt.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <Button href={`mailto:${email}`} variant="primary" size="lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Wyślij e-mail
        </Button>
        <Button href="/faq" variant="outline" size="lg">
          Przejrzyj FAQ
        </Button>
      </div>

      <!-- Direct email display -->
      <div class="mt-10 p-6 rounded-2xl bg-surface-card border border-surface-border">
        <p class="text-xs font-medium uppercase tracking-widest text-white/30 mb-2">Adres e-mail</p>
        <a
          href={`mailto:${email}`}
          class="text-lg font-medium text-white hover:text-accent transition-colors"
        >
          {email}
        </a>
      </div>

      <!-- Response time info -->
      <p class="mt-6 text-sm text-white/30">
        Zazwyczaj odpisuję w ciągu 24 godzin w dni robocze.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>
