---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';

const services = [
  {
    title: 'Strona wizytówkowa',
    description: 'Prosta, elegancka strona prezentująca Twoją firmę lub ofertę. Idealna dla freelancerów, małych firm i specjalistów.',
    includes: [
      'Do 5 podstron',
      'Formularz kontaktowy',
      'Responsywny design',
      'Optymalizacja SEO',
      'Certyfikat SSL',
    ],
  },
  {
    title: 'Strona firmowa',
    description: 'Rozbudowana witryna dla firm, które chcą wyróżnić się w sieci i generować leady sprzedażowe.',
    includes: [
      'Do 10 podstron',
      'Blog lub aktualności',
      'Integracja z Google Analytics',
      'Optymalizacja Core Web Vitals',
      'Wsparcie techniczne 30 dni',
    ],
    featured: true,
  },
  {
    title: 'Sklep / Landing page',
    description: 'Dedykowany projekt dopasowany do specyficznych potrzeb — sklep online, strona produktowa lub kampanijna.',
    includes: [
      'Projekt indywidualny',
      'Integracja z systemem płatności',
      'Testy A/B ready',
      'Analityka konwersji',
      'Wsparcie techniczne 60 dni',
    ],
  },
];
---

<BaseLayout
  title="Oferta"
  description="Tworzę strony wizytówkowe, firmowe i sklepy internetowe. Sprawdź, co mogę zrobić dla Twojego biznesu."
>
  <Header />
  <main class="mx-auto max-w-6xl px-6 py-20 md:py-32">
    <!-- Header -->
    <header class="mb-20 text-center max-w-2xl mx-auto">
      <p class="text-sm font-medium uppercase tracking-widest text-accent mb-3">Co oferuję</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-white">Oferta</h1>
      <p class="mt-4 text-lg text-white/60">
        Każda strona jest dopasowana do potrzeb klienta. Poniżej orientacyjne pakiety — ostateczna wycena zależy od zakresu projektu.
      </p>
    </header>

    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class:list={[
          'relative flex flex-col p-8 rounded-2xl border transition-colors',
          service.featured
            ? 'bg-surface-elevated border-accent/40 ring-1 ring-accent/20'
            : 'bg-surface-card border-surface-border hover:border-white/20',
        ]}>
          {service.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-semibold bg-accent text-white rounded-full">
              Najpopularniejszy
            </span>
          )}

          <h2 class="font-display text-2xl font-bold text-white mb-3">{service.title}</h2>
          <p class="text-sm text-white/60 leading-relaxed mb-8">{service.description}</p>

          <ul class="flex flex-col gap-3 mb-10">
            {service.includes.map((item) => (
              <li class="flex items-start gap-3 text-sm text-white/70">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-auto">
            <Button href="/kontakt" variant={service.featured ? 'primary' : 'outline'} size="md" class="w-full justify-center">
              Zapytaj o wycenę
            </Button>
          </div>
        </div>
      ))}
    </div>

    <!-- Note -->
    <p class="mt-12 text-center text-sm text-white/30">
      Masz niestandardowy projekt? <a href="/kontakt" class="text-white/50 hover:text-white transition-colors underline underline-offset-2">Napisz do mnie</a> — wycenię indywidualnie.
    </p>
  </main>
  <Footer />
</BaseLayout>
