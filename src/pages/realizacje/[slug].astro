---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

const formattedDate = project.data.date.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  ogType="article"
>
  <Header />
  <main class="mx-auto max-w-4xl px-5 pt-28 pb-20 md:pt-36 md:pb-28">

    <!-- Breadcrumb -->
    <nav class="mb-10 flex items-center gap-2 text-sm text-white/40" aria-label="Nawigacja okruszkowa">
      <a href="/#realizacje" class="hover:text-white transition-colors">Realizacje</a>
      <span>/</span>
      <span class="text-white/60">{project.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-14" data-animate="fade-up">
      {project.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {project.data.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-surface-elevated text-white/50 border border-surface-border">
              {tag}
            </span>
          ))}
        </div>
      )}
      <h1 class="font-display text-3xl md:text-5xl font-bold text-white leading-tight">
        {project.data.title}
      </h1>
      <p class="mt-4 text-lg text-white/60 max-w-2xl leading-relaxed">{project.data.description}</p>
      <p class="mt-3 text-sm text-white/30">{formattedDate}</p>
    </header>

    <!-- Thumbnail -->
    {project.data.thumbnail && (
      <div data-animate="fade-up" class="mb-16 rounded-2xl overflow-hidden aspect-video bg-surface-elevated">
        <img
          src={project.data.thumbnail}
          alt={project.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Co zostało zrobione -->
    {project.data.deliverables.length > 0 && (
      <section class="mb-16">
        <p data-animate="fade-up" class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Zakres projektu</p>
        <h2 data-animate="fade-up" data-delay="80" class="font-display text-2xl md:text-3xl font-bold text-white mb-8">Cechy projektu</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          {project.data.deliverables.map((item, i) => (
            <div
              data-animate="fade-up"
              data-delay={String(i * 80)}
              class="flex items-start gap-3 p-4 rounded-xl bg-surface-card border border-surface-border hover:border-accent/30 transition-colors"
            >
              <span class="mt-0.5 w-5 h-5 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0">
                <svg class="w-2.5 h-2.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-sm font-medium text-white/80 leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Galeria -->
    {project.data.gallery.length > 0 && (
      <section class="mb-16">
        <p data-animate="fade-up" class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Galeria</p>
        <h2 data-animate="fade-up" data-delay="80" class="font-display text-2xl md:text-3xl font-bold text-white mb-8">Gotowy projekt</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {project.data.gallery.map((src, i) => (
            <button
              data-animate="fade-up"
              data-delay={String(i * 100)}
              data-lightbox={src}
              class="group relative aspect-video rounded-2xl overflow-hidden bg-surface-elevated border border-surface-border cursor-pointer text-left"
            >
              <img
                src={src}
                alt={`${project.data.title} — zrzut ${i + 1}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Hover overlay z lupką -->
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <div class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                  </svg>
                </div>
              </div>
            </button>
          ))}
        </div>
      </section>
    )}

    <!-- Lightbox -->
    <div
      id="lightbox"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
      aria-modal="true"
      role="dialog"
      aria-label="Podgląd zdjęcia"
    >
      <button
        id="lightbox-close"
        aria-label="Zamknij"
        class="absolute top-4 right-4 w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-[90vw] max-h-[90vh] rounded-2xl object-contain shadow-2xl scale-95 transition-transform duration-300"
      />
    </div>

    <!-- CTA -->
    <section data-animate="fade-up" class="relative overflow-hidden rounded-2xl border border-surface-border bg-surface-card p-8 md:p-10 text-center">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% 120%, rgba(249,115,22,0.08) 0%, transparent 70%);"></div>
      <p class="relative text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Stwórzmy coś razem</p>
      <h2 class="relative font-display text-2xl md:text-3xl font-bold text-white mb-3">
        Potrzebujesz projektu dla swojej firmy?
      </h2>
      <p class="relative text-white/55 max-w-lg mx-auto mb-8 leading-relaxed">
        Chętnie porozmawiamy o Twoich potrzebach i bezpłatnie wycenimy projekt. Skontaktuj się — zazwyczaj odpisujemy w ciągu 24 godzin.
      </p>
      <div class="relative flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/#kontakt" class="btn-primary group inline-flex items-center gap-2 px-6 py-3 text-sm rounded-xl">
          Skontaktuj się
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/#oferta" class="btn-outline inline-flex items-center gap-2 px-6 py-3 text-sm rounded-xl">
          Sprawdź ofertę
        </a>
      </div>
    </section>

    <!-- Back link -->
    <div class="mt-10">
      <a href="/#realizacje" class="inline-flex items-center gap-2 text-sm text-white/40 hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Wszystkie realizacje
      </a>
    </div>

  </main>
  <Footer />
</BaseLayout>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    lightboxImg.classList.remove('scale-95');
    lightboxImg.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    lightboxImg.classList.remove('scale-100');
    lightboxImg.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.lightbox ?? '';
      const alt = btn.querySelector('img')?.alt ?? '';
      openLightbox(src, alt);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
