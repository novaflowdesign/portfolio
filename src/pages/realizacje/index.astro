---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Realizacje"
  description="Przegląd moich projektów — strony internetowe stworzone dla firm, freelancerów i marek osobistych."
>
  <Header />
  <main class="mx-auto max-w-6xl px-6 pt-24 pb-16 md:pt-28 md:pb-20">
    <header class="mb-12 text-center md:text-left">
      <p class="text-sm font-medium uppercase tracking-widest text-accent mb-3">Portfolio</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-white">Realizacje</h1>
      <p class="mt-4 text-lg text-white/60 max-w-xl mx-auto md:mx-0">
        Projekty, przy których mieliśmy przyjemność pracować. Każdy z nich to inna historia i inne wyzwania.
      </p>
    </header>

    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.id}
            thumbnail={project.data.thumbnail}
            tags={project.data.tags}
          />
        ))}
        {[0, 1].map((_) => (
          <a
            href="/#kontakt"
            class="group flex flex-col bg-surface-card border border-dashed border-surface-border rounded-2xl overflow-hidden hover:border-accent/30 hover:bg-accent/5 transition-all duration-300 h-full"
          >
            <div class="aspect-video bg-surface-elevated flex items-center justify-center">
              <div class="w-14 h-14 rounded-full border border-dashed border-white/10 group-hover:border-accent/30 flex items-center justify-center transition-colors duration-300">
                <svg class="w-6 h-6 text-white/15 group-hover:text-accent/50 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </div>
            <div class="flex flex-col flex-1 p-5 md:p-7 gap-3">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/20 group-hover:text-accent/50 transition-colors duration-300 font-display">Twój projekt</p>
              <h2 class="font-display text-xl font-bold text-white/25 group-hover:text-white/45 transition-colors duration-300 leading-snug">
                Tu może być Twój projekt
              </h2>
              <p class="text-sm text-white/20 leading-relaxed">Skontaktuj się z nami — omówimy szczegóły i bezpłatnie wycenimy projekt.</p>
              <span class="mt-auto pt-4 text-sm font-medium text-accent/30 group-hover:text-accent transition-colors inline-flex items-center gap-1">
                Skontaktuj się
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-white/40 text-sm">Projekty pojawią się wkrótce.</p>
    )}

    <!-- CTA kontaktowa -->
    <div class="mt-6 relative rounded-2xl border border-surface-border bg-surface-card overflow-hidden px-8 py-12 md:px-14 md:py-16 text-center">
      <!-- Glow -->
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(ellipse 60% 80% at 50% 110%, rgba(249,115,22,0.10) 0%, transparent 70%);"
        aria-hidden="true"
      ></div>

      <p class="text-xs font-semibold uppercase tracking-[0.2em] font-display mb-3 text-gradient">Zacznijmy razem</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Masz projekt? Porozmawiajmy.
      </h2>
      <p class="text-white/55 max-w-lg mx-auto leading-relaxed mb-8">
        Każda dobra strona zaczyna się od rozmowy. Opisz swój pomysł — bezpłatnie wycenimy i doradzimy najlepsze rozwiązanie.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/#kontakt"
          class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold"
        >
          Napisz do nas
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="mailto:novaflowdesign@gmail.com"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-medium text-white/60 hover:text-white border border-surface-border hover:border-white/20 transition-colors"
        >
          novaflowdesign@gmail.com
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
