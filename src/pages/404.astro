---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';
---

<BaseLayout
  title="Strona nie znaleziona"
  description="Strona, której szukasz, nie istnieje lub została przeniesiona."
>
  <Header />
  <main class="flex-1 flex flex-col items-center justify-center text-center px-6 py-32">
    <p class="font-display text-8xl font-bold text-white/10 mb-4 select-none">404</p>
    <h1 class="font-display text-3xl font-bold text-white mb-4">Strona nie znaleziona</h1>
    <p class="text-white/60 mb-10 max-w-md">
      Strona, której szukasz, nie istnieje lub została przeniesiona.
    </p>
    <Button href="/" variant="primary" size="md">
      Wróć na stronę główną
    </Button>
  </main>
  <Footer />
</BaseLayout>
